APP_NAME="OWWA Inventory"
APP_ENV=local
APP_KEY=
# Set to false in production to show friendly error pages instead of debug output
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=Capstone_DB
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1
PUSHER_SCHEME=https
PUSHER_PORT=443
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
# Poll requisition lists when Echo/Pusher is unavailable. Set empty to disable.
REQUISITION_POLL_INTERVAL=60s
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — local dev: use log or Gmail SMTP (see below).
# Render production: MAIL_MAILER=log, QUEUE_CONNECTION=database; run queue:work on laptop for real email.
# See docs/UAT_EMAIL_HYBRID.md for capstone UAT setup (Render + Neon + laptop worker + Gmail).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Ollama (DeepSeek v3.2 7B) for RAG and procurement analytics
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen2.5:3b

# Shared secret for GET /api/rag/context (Authorization: Bearer …). Empty = deny all.
RAG_CONTEXT_TOKEN=

# Production seeding: SEED_ON_BOOT only works with ALLOW_PRODUCTION_SEED=true.
# ALLOW_PRODUCTION_SEED=false

# LibreOffice headless PDF (Excel-like). Falls back to Dompdf if unavailable.
# Windows: use forward slashes so dotenv does not treat \ as escapes.
# LIBREOFFICE_BINARY="C:/Program Files/LibreOffice/program/soffice.exe"
LIBREOFFICE_PDF=true
LIBREOFFICE_BINARY=soffice
LIBREOFFICE_TIMEOUT=90
LIBREOFFICE_BINARY="C:/Program Files/LibreOffice/program/soffice.exe"